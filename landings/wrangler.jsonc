{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "issuenumberone",
  "compatibility_date": "2026-06-23",
  "workers_dev": true,
  // Static Astro landing + Angular app shell, with code only where it is
  // needed. run_worker_first lists the ONLY paths that invoke worker.js; every
  // other request is a free static asset (rewrites/headers in public/_redirects
  // and public/_headers). Why each path needs code:
  //   /waitlist                 POST writes the signup to KV.
  //   /, /issues, /issues/*     server-rendered from the live public Q&A API.
  //   /questions, /questions/*  server-rendered question pages; /questions/new
  //                             and ?preview=1 get the app shell (query match).
  //   /sitemap.xml              built from the live catalog.
  // not_found_handling is set so navigation misses never invoke the Worker.
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/waitlist",
      "/",
      "/issues",
      "/issues/*",
      "/questions",
      "/questions/*",
      "/sitemap.xml"
    ],
    "not_found_handling": "404-page"
  },
  "vars": {
    // Cloud Run origin of the Sneat backend (same one sneat-api-proxy forwards
    // api.sneat.cloud to). The public /v0/issuenumber/{catalog,question} GETs
    // need no origin secret, and skipping api.sneat.cloud avoids a second
    // Worker invocation per API call.
    "ISSUENUMBER_API_ORIGIN": "https://sneat-app-354fvnqbaa-ew.a.run.app"
  },
  // Waitlist signups: {email, ts, source} keyed by waitlist:<email>.
  // Created 2026-07-09 as `issue_number_one_waitlist`.
  "kv_namespaces": [
    {
      "binding": "WAITLIST",
      "id": "1e76de23d7e8402f9a3c86611f7121a8"
    }
  ]
  // NOTE: the custom domain issuenumber.one is attached by the main session on
  // the issuenumber.one zone (AAAA + worker route). No DNS/route config here.
}
