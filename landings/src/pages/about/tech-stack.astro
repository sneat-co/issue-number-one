---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "IssueNumber.one tech stack — how it's built";
const description = "How IssueNumber.one serves public issues and builds its priority tools with Astro, Cloudflare, Angular, Ionic, Go, and SpecScore.";
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: title,
  description,
  url: pageUrl,
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).toString() },
      { "@type": "ListItem", position: 2, name: "Tech stack", item: pageUrl },
    ],
  },
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="container story">
    <nav aria-label="Breadcrumb" class="breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Tech stack</span></nav>
    <p class="eyebrow">How it's built</p>
    <h1>Tools for finding the one issue that matters</h1>
    <p class="lead">A tech stack is the collection of tools used to build and run a product. IssueNumber.one helps people surface a priority through questions and answers, while teams can focus on the issues they would fix first.</p>

    <section aria-labelledby="website">
      <h2 id="website">This website</h2>
      <p>Astro builds the marketing pages as static files. A Cloudflare Worker serves the public question and issue pages from the live catalog, while Cloudflare serves the static pages directly. The same deployment carries the Angular app for signed-in routes.</p>
    </section>
    <section aria-labelledby="product">
      <h2 id="product">The product</h2>
      <p>The interactive app uses Angular and Ionic. A Go service owns the public question and answer API and stores its data in Firestore. Public pages show reviewed, indexable questions; private answers and identity fields stay behind the authenticated API. The frontend and backend are tested in their own workspaces.</p>
    </section>
    <section aria-labelledby="tools">
      <h2 id="tools">Our tools used here</h2>
      <p><a href="https://specscore.md/">SpecScore</a> structures the project's specifications. Shared <a href="https://sneat.co/about/tech-stack/">Sneat platform</a> packages supply authentication and Space foundations to the app. The public pages use the same issue catalog as the Go service, so search visitors can reach current questions.</p>
    </section>
    <section aria-labelledby="related">
      <h2 id="related">Related projects</h2>
      <p><a href="https://ingitdb.com/">inGitDB</a> is explored in the project's Git storage specification as a data ownership option. It is related work, not the current Firestore storage path.</p>
    </section>
  </div>
</BaseLayout>

<style>
  .story { max-width: 820px; padding-block: var(--space-4) var(--space-5); }
  .breadcrumb { display: flex; gap: .6rem; align-items: center; margin-bottom: var(--space-4); color: var(--color-text-muted); font-size: .9rem; }
  .lead { font-size: 1.18rem; color: var(--color-text); border-left: 4px solid var(--color-accent); padding-left: var(--space-2); margin-block: var(--space-3) var(--space-4); }
  section { padding-block: var(--space-3); border-top: 1px solid var(--color-border); }
  section p:last-child { margin-bottom: 0; }
</style>
